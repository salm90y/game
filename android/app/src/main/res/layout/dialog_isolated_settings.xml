<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </RelativeLayout>

    <!-- ROM & BIOS Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cat_rom_bios"
        android:textColor="#34D399"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_load_rom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#065F46"
        android:text="@string/action_load_rom"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txt_rom_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="اللعبة الحالية: Combat 3 (Built-in)"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_load_bios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#1E293B"
        android:text="@string/action_load_bios"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txt_bios_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="البيوس: HLE High-Level Emulation (تلقائي)"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="#334155" />

    <!-- Controller Settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cat_controller_gamepad"
        android:textColor="#38BDF8"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_reset_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#1E293B"
        android:text="@string/action_reset_mapping"
        android:textColor="#FFFFFF" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#334155" />

    <!-- Leave Room -->
    <Button
        android:id="@+id/btn_leave_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#EF4444"
        android:text="@string/action_leave_room"
        android:textColor="#FFFFFF" />

</LinearLayout>
